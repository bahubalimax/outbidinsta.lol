# ---------------------------------------------------------------------------
# OutBidInsta environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL) --------------------------------------------
# App runtime uses the POOLED connection string.
#   Neon:  postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true
#   Local: postgresql://postgres:postgres@localhost:5432/outbidinsta?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/outbidinsta?schema=public"

# Migrations use the DIRECT (non-pooled) connection string.
#   Neon:  postgresql://USER:PASS@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require
# On a single-URL setup, point this at the same value as DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/outbidinsta?schema=public"

# --- Site ------------------------------------------------------------
# Public base URL, no trailing slash. Used for canonical URLs, OG tags,
# sitemap, robots and Dodo return URLs.
NEXT_PUBLIC_SITE_URL="https://outbidinsta.lol"

# --- Dodo Payments -----------------------------------------------------
# API key from the Dodo dashboard (Developer > API Keys).
DODO_API_KEY=""
# Webhook signing secret (Developer > Webhooks) for the endpoint
#   https://outbidinsta.lol/api/webhooks/dodo
DODO_WEBHOOK_SECRET=""
# "test_mode" or "live_mode"
DODO_ENVIRONMENT="test_mode"
# The Dodo product id used for every bid. Create ONE product in the Dodo
# dashboard with "Pay what you want" pricing enabled, currency USD, and paste
# its id here (looks like "pdt_xxxxxxxx").
DODO_BID_PRODUCT_ID=""

# --- Admin -------------------------------------------------------------
# Credentials for the /admin dashboard. Use a long random password.
ADMIN_EMAIL="admin@outbidinsta.lol"
ADMIN_PASSWORD="change-me-to-a-long-random-string"
# Secret used to sign the admin session cookie (min 32 chars).
# Generate with:  openssl rand -base64 48
AUTH_SECRET="generate-a-long-random-secret-at-least-32-chars"

# --- Optional --------------------------------------------------------
# Currencies admins may switch to. USD is always allowed. Dodo pay-what-you-want
# supports USD, EUR, GBP, INR.
SUPPORTED_CURRENCIES="USD,EUR,GBP,INR"
# Shown on the /contact page.
NEXT_PUBLIC_SUPPORT_EMAIL="support@outbidinsta.lol"
